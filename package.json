{
  "name": "playwright-ai",
  "version": "2.0.0-alpha.0",
  "description": "Command-line utility that generates Playwright end-to-end tests from a web page using Claude or OpenAI models",
  "main": "index.js",
  "type": "module",
  "bin": {
    "playwright-ai": "./index.js"
  },
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/",
    "test:watch": "node --test --watch test/",
    "test:e2e": "node --test e2e/",
    "test:all": "node --test test/ e2e/",
    "lint": "prettier --check \"**/*.{js,md,json}\"",
    "format": "prettier --write \"**/*.{js,md,json}\""
  },
  "keywords": [
    "playwright",
    "testing",
    "e2e",
    "llm",
    "claude",
    "anthropic",
    "openai",
    "test-generation"
  ],
  "author": "Vlad Filippov",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vladikoff/playwright-ai.git"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "debug": "^4.4.3",
    "listr2": "^11.4.0",
    "openai": "^7.47.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
